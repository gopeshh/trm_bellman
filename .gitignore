# ----------------------------
# Python
# ----------------------------
__pycache__/
.pytest_cache/
*.py[cod]
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# ----------------------------
# Torch / ML artifacts
# ----------------------------
*.pt
*.pth
*.ckpt
checkpoints/
lightning_logs/
wandb/
tensorboard/

# ----------------------------
# Project-specific
# ----------------------------
# Temporary outputs
tmp/
temp/
outputs/
results/
logs/
*.profraw
*.pid
*.lock
*.partial.*
*.smoke.log
/slurm_*.txt
/*.log

# Dataset artifacts (ignore by default, but allow small reproducibility datasets)
datasets/
data/*
!data/sudoku-4x4-trivial/
!data/iclr-confirmatory-sudoku4x4-v1/
!data/iclr-confirmatory-sudoku4x4-v1/**
*.zip
artifact/*.zip
artifact/*.zip.sha256
*.tar
*.tar.gz

# ----------------------------
# IDE / editor files
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# MacOS
.DS_Store

# ----------------------------
# Build artifacts
# ----------------------------
build/
dist/
*.egg-info/

# ----------------------------
# Cursor / Debug Logs
# ----------------------------
.cursor/

# ----------------------------
# Keep run directories out of git, but allow small summaries
# ----------------------------
# Note: `runs/` is ignored above; the rules below selectively un-ignore small
# human-readable summaries so results can be shared without committing raw logs.
runs/**
!runs/**/
!runs/**/RESULTS.md
!runs/**/WAVE*_RESULTS*.md
!runs/**/COMMANDS*.md

# ----------------------------
# Claude Code (machine-specific)
# ----------------------------
.claude/settings.local.json
